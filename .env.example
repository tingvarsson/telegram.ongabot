# Template for the local dev-bot env files: copy it to .env.d/<botname> once per dev bot,
# e.g. .env.d/ongadev2 (see README). `make run` loads the file of the bot it starts.

# Telegram bot API token
API_TOKEN=your_telegram_bot_token_here

# Telegram user IDs (comma-separated) allowed to run /authorize and /deauthorize
BOT_ADMINS=your_telegram_user_id

# Optional: Chat IDs (comma-separated) to authorize on startup — useful for bootstrapping existing groups.
# For a dev bot, set its test group here so a new, empty database is authorized from the first start.
AUTHORIZED_CHAT_IDS=

# Optional: logging level (default: INFO)
LOG_LEVEL=INFO

# Optional: IANA timezone for every chat that has not picked its own with /timezone
# (default: UTC), e.g. Europe/Stockholm. Weekly polls, event times, game-day pokes and CS2
# results follow it. An unknown name logs a warning and falls back to UTC.
BOT_TIMEZONE=

# Optional: path to the pickle persistence database (default: ongabot.db)
# Ignored by `make run`, which gives each dev bot its own ongabot-<bot>.db per checkout.
DB_PATH=ongabot.db

# Optional: path to CHANGELOG.md for the /changelog command and startup announcements
# In Docker the file is copied to /ongabot/CHANGELOG.md (default, no override needed).
# For local dev via 'make run', set to the repo-root file relative to where make is invoked:
CHANGELOG_PATH=CHANGELOG.md

# Optional: Leetify API key for CS2 match results (https://leetify.com/app/developer).
# The public API works without one, but anonymous requests face tighter rate limits.
LEETIFY_API_KEY=

# Optional: linked members needed in one match before it counts as an ONGA game
# (default: 2). Set to 1 in a test deployment where only one person has linked an
# account - otherwise nothing can ever reach the threshold. In a real chat, 1 reports
# every matchmaking game any single member plays.
CS2_MIN_MEMBERS=

# Optional: hours before an event starts that the bot pokes members who have not voted,
# when no slot has a full five-stack yet (default: 10). Fractions work, e.g. 0.1 on a dev bot.
POKE_LEAD_HOURS=

# Required for /short (console.cloud.google.com, enable "YouTube Data API v3").
# Without it, the bot logs an error and /short posts nothing.
YOUTUBE_API_KEY=

# Optional: how often, in minutes, to check Steam for new CS2 patch notes (default: 20).
# Read at startup. Chats opt in with /cs2patches on.
CS2_PATCHNOTES_POLL_MINUTES=
