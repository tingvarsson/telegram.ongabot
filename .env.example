# Telegram bot API token
API_TOKEN=your_telegram_bot_token_here

# Telegram user IDs (comma-separated) allowed to run /authorize and /deauthorize
BOT_ADMINS=your_telegram_user_id

# Optional: Chat IDs (comma-separated) to authorize on startup — useful for bootstrapping existing groups
AUTHORIZED_CHAT_IDS=

# Optional: logging level (default: INFO)
LOG_LEVEL=INFO

# Optional: path to the pickle persistence database (default: ongabot.db)
DB_PATH=ongabot.db

# Optional: path to CHANGELOG.md for the /changelog command and startup announcements
# In Docker the file is copied to /ongabot/CHANGELOG.md (default, no override needed).
# For local dev via 'make run', set to the repo-root file relative to where make is invoked:
CHANGELOG_PATH=CHANGELOG.md

# Optional: Leetify API key for CS2 match results (https://leetify.com/app/developer).
# The public API works without one, but anonymous requests face tighter rate limits.
LEETIFY_API_KEY=

# Optional: linked members needed in one match before it counts as an ONGA game
# (default: 2). Set to 1 in a test deployment where only one person has linked an
# account - otherwise nothing can ever reach the threshold. In a real chat, 1 reports
# every matchmaking game any single member plays.
CS2_MIN_MEMBERS=

# Required for the daily YouTube Short feature (console.cloud.google.com, enable
# "YouTube Data API v3"). Without it, the bot logs an error and posts nothing.
# Also requires the bot to be an administrator in a chat, so Telegram sends it the
# per-user reaction detail that drives topic learning - a non-admin bot only sees
# aggregate reaction counts and never learns from them.
YOUTUBE_API_KEY=

# Optional: daytime window the bot picks a random post time within, per chat, per
# day, so the daily Short doesn't land at the same clock time (or at 3am) every day.
# Format HH:MM, 24h. Defaults shown.
YOUTUBE_SHORTS_WINDOW_START=10:00
YOUTUBE_SHORTS_WINDOW_END=20:00
